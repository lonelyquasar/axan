<?xml version="1.0" encoding="utf-8"?>
<!--
  axan #9: stamp a Win32 VERSIONINFO resource into every exe/dll the fork builds.

  Upstream's version stamping lives in an internal NuGet package its release pipeline
  installs (see build/pipelines/templates-v2/steps-setup-versioning.yml); without it the
  VersionInfoFileDescription each vcxproj declares never reaches the binary. This file
  is the fork's replacement: imported once from common.build.post.props, it

    1. reads the package version from the CascadiaPackage manifest that matches the
       current branding (the same selection CascadiaPackage.wapproj makes), so the
       binaries' FileVersion/ProductVersion always equal the MSIX Identity Version;
    2. writes $(IntDir)axan_versioninfo.h with that version plus the project's
       description / file names / type (regenerated only when the content changes, so
       incremental builds stay incremental);
    3. compiles build/rules/VersionInfo.rc, which #includes that header, into the
       project alongside any .rc it already has.

  Static libraries, non-C++ projects, and the PGO/scratch builds are skipped. A project
  without a VersionInfoFileDescription gets its target name as the description.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_AxanStampVersionInfo Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and ('$(ConfigurationType)'=='Application' or '$(ConfigurationType)'=='DynamicLibrary')">true</_AxanStampVersionInfo>
    <_AxanStampVersionInfo Condition="'$(AxanSkipVersionInfo)'=='true'">false</_AxanStampVersionInfo>

    <_AxanManifestDir>$(SolutionDir)src\cascadia\CascadiaPackage\</_AxanManifestDir>
    <_AxanVersionManifest Condition="'$(WindowsTerminalBranding)'=='Release'">$(_AxanManifestDir)Package.appxmanifest</_AxanVersionManifest>
    <_AxanVersionManifest Condition="'$(WindowsTerminalBranding)'=='Preview'">$(_AxanManifestDir)Package-Pre.appxmanifest</_AxanVersionManifest>
    <_AxanVersionManifest Condition="'$(WindowsTerminalBranding)'=='Canary'">$(_AxanManifestDir)Package-Can.appxmanifest</_AxanVersionManifest>
    <_AxanVersionManifest Condition="'$(_AxanVersionManifest)'==''">$(_AxanManifestDir)Package-Dev.appxmanifest</_AxanVersionManifest>

    <_AxanVersionInfoHeader>$(IntDir)axan_versioninfo.h</_AxanVersionInfoHeader>

    <VersionInfoProductName Condition="'$(VersionInfoProductName)'==''">axan</VersionInfoProductName>
    <VersionInfoCompanyName Condition="'$(VersionInfoCompanyName)'==''">Lonely Quasar</VersionInfoCompanyName>
    <VersionInfoCopyRight Condition="'$(VersionInfoCopyRight)'==''">(c) Microsoft Corporation and Lonely Quasar. All rights reserved.</VersionInfoCopyRight>
    <VersionInfoFileDescription Condition="'$(VersionInfoFileDescription)'==''">$(TargetName)</VersionInfoFileDescription>

    <_AxanVft Condition="'$(ConfigurationType)'=='Application'">VFT_APP</_AxanVft>
    <_AxanVft Condition="'$(ConfigurationType)'=='DynamicLibrary'">VFT_DLL</_AxanVft>
    <_AxanVft Condition="'$(_AxanVft)'==''">VFT_UNKNOWN</_AxanVft>
  </PropertyGroup>

  <ItemGroup Condition="'$(_AxanStampVersionInfo)'=='true'">
    <ResourceCompile Include="$(SolutionDir)build\rules\VersionInfo.rc">
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemGroup>

  <Target Name="AxanGenerateVersionInfoHeader"
          Condition="'$(_AxanStampVersionInfo)'=='true'"
          BeforeTargets="ResourceCompile">
    <Error Condition="!Exists('$(_AxanVersionManifest)')" Text="axan VersionInfo: package manifest not found at $(_AxanVersionManifest)" />

    <XmlPeek XmlInputPath="$(_AxanVersionManifest)"
             Query="/ns:Package/ns:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;">
      <Output TaskParameter="Result" ItemName="_AxanVersionFromManifest" />
    </XmlPeek>

    <PropertyGroup>
      <_AxanVersion>@(_AxanVersionFromManifest)</_AxanVersion>
      <_AxanVersion Condition="'$(_AxanVersion)'==''">0.0.0.0</_AxanVersion>
      <_AxanVersionComma>$(_AxanVersion.Replace('.', ','))</_AxanVersionComma>
    </PropertyGroup>
    <Error Condition="'@(_AxanVersionFromManifest)'==''" Text="axan VersionInfo: no Identity Version in $(_AxanVersionManifest)" />

    <ItemGroup>
      <_AxanVersionInfoLine Include="// Generated by build/rules/VersionInfo.targets - do not edit." />
      <_AxanVersionInfoLine Include="#define AXAN_VER_COMMA $(_AxanVersionComma)" />
      <_AxanVersionInfoLine Include="#define AXAN_VER_STRING &quot;$(_AxanVersion)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_VFT $(_AxanVft)" />
      <_AxanVersionInfoLine Include="#define AXAN_COMPANY_NAME &quot;$(VersionInfoCompanyName)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_PRODUCT_NAME &quot;$(VersionInfoProductName)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_COPYRIGHT &quot;$(VersionInfoCopyRight)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_FILE_DESCRIPTION &quot;$(VersionInfoFileDescription)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_INTERNAL_NAME &quot;$(TargetName)&quot;" />
      <_AxanVersionInfoLine Include="#define AXAN_ORIGINAL_FILENAME &quot;$(TargetFileName)&quot;" />
    </ItemGroup>

    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(_AxanVersionInfoHeader)"
                      Lines="@(_AxanVersionInfoLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_AxanVersionInfoHeader)" />
    </ItemGroup>
  </Target>

</Project>
