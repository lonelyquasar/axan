namespace Microsoft.Terminal.UI
{
    static runtimeclass IconPathConverter
    {
        static Windows.UI.Xaml.Controls.IconElement IconWUX(String path);
        static Windows.UI.Xaml.Controls.IconSource IconSourceWUX(String path);
        static Microsoft.UI.Xaml.Controls.IconSource IconSourceMUX(String path, Boolean convertToGrayscale);
        // axan: sidebar.iconFontScale (font family -> multiplier for one-character icons,
        // over the built-in table in src/inc/AxanGlyphScale.h). Process-wide; null clears it.
        // Icons already rendered keep their size until they are rebuilt. Family names match
        // case-insensitively. Returns the scales' generation, which changes only when the
        // effective map does, so each window can tell whether its icons need rebuilding.
        static UInt64 SetIconFontScales(Windows.Foundation.Collections.IMap<String, Double> scales);
        // axan #48: sidebar.iconFontWeight (font family -> "normal" | "semibold" | "bold", see
        // src/inc/AxanGlyphWeight.h), the same way. Shares the scales' generation counter, so
        // the value returned by whichever of the two is called last covers both maps.
        static UInt64 SetIconFontWeights(Windows.Foundation.Collections.IMap<String, String> weights);
    };

}
