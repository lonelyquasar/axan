// SessionNodeViewModel — axan M6: the per-node identity carried as a session-tree node's
// Content. Once nodes can be dragged to reorder/reparent, the old flat "RootNodes index ==
// _tabs index" mapping is dead, so each node needs a stable handle to its session that
// travels with the node through any move. The view-model is that handle: the displayed
// Label (observable, so the M5 templated-label recompute just sets it and the bound
// TreeViewItem refreshes — no ContainerFromNode poke needed), plus the owning Tab and its
// label template (impl-only; see SessionNodeViewModel.h — not projected because only the
// C++ tree plumbing reads them).

namespace TerminalApp
{
    [default_interface] runtimeclass SessionNodeViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        SessionNodeViewModel();

        // The text shown for this node. Bound OneWay by the TreeView ItemTemplate; the M6
        // recompute path sets it and INotifyPropertyChanged refreshes the realized item.
        String Label { get; set; };

        // axan M7: the icon shown left of the label, hosted in the ItemTemplate's
        // ContentPresenter — the WT-proven pattern (BasePaletteItem/CommandPalette); the muxc
        // IconSourceElement markup tag isn't in the XAML compiler's WinUI-2 type universe
        // here. Read-only and built FRESH on every get (the impl resolves the path —
        // override -> profile icon -> auto-assigned glyph — and IconWUX mints a new element):
        // a cached IconElement is a UIElement, and binding one instance into the node's
        // TreeViewItem as it's recycled during a drag reparent throws "element already has a
        // parent" and crashes. INotifyPropertyChanged("Icon") re-pulls a fresh element.
        Windows.UI.Xaml.Controls.IconElement Icon { get; };

        // axan M13 (design handoff): the brush for the node's label text. When the node's
        // recolor targets the text (Apply color to = Text or Both), this is the chosen color;
        // otherwise it's the default theme text brush. Bound OneWay by the tree ItemTemplate's
        // TextBlock Foreground so a recolor repaints the label without a container poke.
        Windows.UI.Xaml.Media.Brush LabelBrush { get; };

        // axan M8: a short (<=4 char) abbreviation of a display name, shown beneath the icon
        // in the minimized sidebar's cells (mirrors the Linux minimized initials). Static so
        // the minimized cell can x:Bind Initials(Label) and re-derive whenever Label changes.
        static String Initials(String label);

        // axan #3: separator rows. A separator node's Content is still a SessionNodeViewModel
        // (one node type, one ItemTemplate) with IsSeparator true, no session behind it, and
        // the divider's stored shape: SeparatorStyle ("line" = hairline rule, "space" = empty
        // gap), SeparatorHeight in session-row units (0.1..10, tenths), and Placement
        // ("inline" keeps its list position, "bottom" is pinned to the end of its sibling
        // scope). Read-only from XAML — separators are authored on the Startup sessions
        // settings page; the live tree only renders them and lets Ctrl+Alt reorder them.
        Boolean IsSeparator { get; };
        String SeparatorStyle { get; };
        Double SeparatorHeight { get; };
        String Placement { get; };
        // axan #3: the render-side switches the shared ExpandedNodeTemplate binds. The
        // session Grid (icon + label) shows for a session, the separator Grid for a
        // separator; SeparatorLineVisibility is Visible only for the "line" style;
        // SeparatorPixelHeight is SeparatorHeight x one session row (the
        // TreeViewItemMinHeight theme resource, resolved by the page at node creation).
        Windows.UI.Xaml.Visibility SessionVisibility { get; };
        Windows.UI.Xaml.Visibility SeparatorVisibility { get; };
        Windows.UI.Xaml.Visibility SeparatorLineVisibility { get; };
        Double SeparatorPixelHeight { get; };

        // axan #30: the session's state (see AxanSessionState.h), observable so the row
        // rendering (#32, #31) is pure binding. State is one of "idle", "running",
        // "working", "needs-you", "done-unseen", "error". StateSince is when the node
        // entered State (UI-thread clock); StateMessage is the OSC 7501 msg (or title) of
        // the record that decided the state, "bell" for a plain-shell bell, else "";
        // StateKind is "permission" / "question" / "auth" for needs-you, else "".
        // LastActivity is the latest user-input or output time across the tab's panes,
        // refreshed by the sidebar's 1s clock (default DateTime = no activity yet).
        String State { get; };
        Windows.Foundation.DateTime StateSince { get; };
        String StateMessage { get; };
        String StateKind { get; };
        Windows.Foundation.DateTime LastActivity { get; };

        // axan #32: the row's rendering of State, all derived here so the ItemTemplate is
        // pure binding. The state dot overlays the icon's bottom-right corner: needs-you is
        // an inverted badge (fill = the theme text colour, ring = its opposite) so it reads
        // against any user node colour; done-unseen is the same dot at low alpha (softer);
        // error is red with the same ring. StateGlyph is a static (never animated) glyph at
        // the row's right edge for working / running. SubLabel is the optional second line:
        // the 7501 msg (or the blocked kind / state word) plus an age for the states where
        // waiting time matters ("permission · 4m", "done · 25m"); "" collapses the line.
        // SubLabel is the message alone and SubLabelAge the " · 4m" suffix ("" when the
        // state shows no age): the row lays them out in two columns so the age is never
        // trimmed and the message ellipsizes into the remaining width.
        // StateToolTip (under the label in the row tooltip) is the state, its kind, the
        // absolute local time it began and the full message; "" and Collapsed when idle.
        Windows.UI.Xaml.Visibility StateDotVisibility { get; };
        Windows.UI.Xaml.Media.Brush StateDotFill { get; };
        Windows.UI.Xaml.Media.Brush StateDotStroke { get; };
        String StateGlyph { get; };
        Windows.UI.Xaml.Visibility StateGlyphVisibility { get; };
        // axan: StateGlyph as an icon element (sidebar.stateGlyphs accepts the node icon
        // vocabulary: glyph, emoji or image). A fresh element per get, like Icon.
        Windows.UI.Xaml.Controls.IconElement StateGlyphIcon { get; };
        // axan: the slot's small state word (sidebar.stateLabels; "" when off or no slot
        // state), the slot as a whole (glyph and/or word), and its explanation tooltip.
        String StateWord { get; };
        Windows.UI.Xaml.Visibility StateWordVisibility { get; };
        Windows.UI.Xaml.Visibility SlotVisibility { get; };
        String SlotToolTip { get; };
        String SubLabel { get; };
        String SubLabelAge { get; };
        Windows.UI.Xaml.Visibility SubLabelVisibility { get; };
        // axan: 0.7 for a live state's second line, 0.45 for a kept (already seen) report
        // under sidebar.statusAfterSeen = keep. StateGlyph is the sidebar.stateGlyphs glyph for
        // the node's slot state (idle = an agent at rest; "" = nothing).
        Double SubLabelOpacity { get; };
        String StateToolTip { get; };
        Windows.UI.Xaml.Visibility StateToolTipVisibility { get; };

        // axan #31: idle de-emphasis. An idle node with no input/output for the configured
        // sidebar.idleAfterMinutes is de-emphasised. sidebar.idleEffects picks how: "dim"
        // (RowOpacity), "smaller" (LabelFontSize and RowMinHeight become sidebar.idleLabelFontSize
        // and sidebar.idleRowHeight, axan #47), "gray"
        // (a coloured node's Icon / LabelBrush go neutral gray), "collapse" (the page tucks
        // away idle rows under expanded section headers and parent rows, axan #46; see
        // AxanIdleEffects.h). needs-you /
        // done-unseen / error are never de-emphasised; any activity or a working/running
        // state promotes the row back on the next update. No animation.
        Boolean IsDeEmphasised { get; };
        Double LabelFontSize { get; };
        // axan: sidebar.stateLineFontSize (the second line and the slot's state word) and
        // sidebar.iconSize (the node icon's box). LabelFontSize follows sidebar.labelFontSize.
        Double StateLineFontSize { get; };
        Double IconSize { get; };
        // axan #48: sidebar.largeIconsGrowRow. The fixed Width/Height of the icon box and its
        // ContentPresenter: IconSize while off (a larger glyph is clipped to the box), NaN (Auto)
        // while on, so the glyph's full size drives layout and the row grows to fit. The box
        // keeps MinWidth/MinHeight = IconSize either way.
        Double IconBoxSize { get; };
        Double RowOpacity { get; };
        Double RowMinHeight { get; };

        // axan #33: section headers. A separator with a label (SeparatorLabel) is a section
        // header: a muted label, a chevron (CollapseGlyph) and, while collapsed, a summary of
        // what it hides (SectionSummary " · 5") plus the strongest #30 state among the hidden
        // rows (SectionBadge "1 needs you"); ActivateSectionBadge expands the section and
        // selects that row. Collapsing never reparents: every row it hides (any node, header
        // or not) just has IsSectionHidden set, which the page maps onto the row container's
        // Visibility. An unlabelled separator is exactly the #3 divider.
        String SeparatorLabel { get; };
        Windows.UI.Xaml.Visibility SeparatorHeaderVisibility { get; };
        Windows.UI.Xaml.Visibility SeparatorHeaderLineVisibility { get; };
        Boolean IsCollapsed { get; };
        String CollapseGlyph { get; };
        String SectionSummary { get; };
        String SectionBadge { get; };
        Windows.UI.Xaml.Visibility SectionBadgeVisibility { get; };
        void ActivateSectionBadge();
        Boolean IsSectionHidden { get; };

        // axan #46: the "collapse" idle effect's idle-collapsed state, shared by section
        // headers and session rows with children. The page hides idle members/children (via
        // IsSectionHidden, never by closing the expander) and shows a small hollow dot in the
        // expander slot (IdleTuckVisibility; no count on it). FoldToolTip is the hidden-row
        // count in words ("4 idle
        // sessions tucked away"; "" = nothing hidden) for the row tooltip; HeaderToolTip is the
        // same text boxed for a section header (null = no tooltip).
        Windows.UI.Xaml.Visibility IdleTuckVisibility { get; };
        String FoldToolTip { get; };
        Windows.UI.Xaml.Visibility FoldToolTipVisibility { get; };
        Object HeaderToolTip { get; };
    }
}
