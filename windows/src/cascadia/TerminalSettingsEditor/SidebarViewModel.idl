//
// axan #38: the Settings > Sessions > Sidebar page view-model. Every sidebar.* global
// (and sidebarMatchesProfileTransparency) lives here; they moved out of Appearance
// verbatim, JSON keys unchanged.

import "EnumEntry.idl";

#include "ViewModelHelpers.idl.h"

namespace Microsoft.Terminal.Settings.Editor
{
    runtimeclass SidebarViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        SidebarViewModel(Microsoft.Terminal.Settings.Model.GlobalAppSettings globalSettings);

        // sidebar.statusAfterSeen
        IInspectable CurrentSidebarStatusAfterSeen;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> SidebarStatusAfterSeenList { get; };

        // sidebar.stateGlyphs. key = a slot state (AxanStateGlyphs.h kKeys). Set takes the
        // NATIVE icon string the picker produced ("" = show nothing); Reset drops the key so
        // the state goes back to its default. Preview / Label are per-key properties so the
        // page binds them (PropertyChanged fires for all of them on any change).
        String SidebarStateGlyphText(String key);
        void SetSidebarStateGlyph(String key, String nativeIcon);
        void ResetSidebarStateGlyph(String key);
        Windows.UI.Xaml.Controls.IconElement SidebarIdleGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarWorkingGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarBlockedGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarDoneGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarErrorGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarRunningGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarPermissionGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarQuestionGlyphPreview { get; };
        Windows.UI.Xaml.Controls.IconElement SidebarAuthGlyphPreview { get; };
        String SidebarIdleGlyphLabel { get; };
        String SidebarWorkingGlyphLabel { get; };
        String SidebarBlockedGlyphLabel { get; };
        String SidebarDoneGlyphLabel { get; };
        String SidebarErrorGlyphLabel { get; };
        String SidebarRunningGlyphLabel { get; };
        String SidebarPermissionGlyphLabel { get; };
        String SidebarQuestionGlyphLabel { get; };
        String SidebarAuthGlyphLabel { get; };

        // axan #34: sidebar.hoistStates, the states that put a session in the sidebar's
        // hoisted group (AxanHoistRule.h names). Unset = ["blocked", "error", "done"].
        // Summary is the expander's one-line current value.
        Boolean SidebarHoistStateEnabled(String name);
        void SetSidebarHoistStateEnabled(String name, Boolean enabled);
        void ResetSidebarHoistStates();
        String SidebarHoistStatesSummary { get; };

        // axan: sidebar.idleEffects, what an idle row does (AxanIdleEffects.h names: dim,
        // smaller, gray, collapse). Unset = ["dim", "smaller"]. Summary is the expander's
        // one-line current value.
        Boolean SidebarIdleEffectEnabled(String name);
        void SetSidebarIdleEffectEnabled(String name, Boolean enabled);
        void ResetSidebarIdleEffects();
        String SidebarIdleEffectsSummary { get; };

        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarMatchesProfileTransparency);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, SidebarIdleAfterMinutes); // axan #31
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarNeedsYouGroup); // axan #34
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarHoistPreview); // axan #49
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarStateLineMarquee); // axan #49
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarStateLabels);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarShowAgentName);
        // axan: the "Text and icons" sizes (sidebar.labelFontSize / stateLineFontSize /
        // iconSize / stateGlyphSize).
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarLabelFontSize);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarStateLineFontSize);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarIconSize);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarStateGlyphSize);
        // axan #47: sidebar.idleLabelFontSize / idleRowHeight, the "smaller" idle effect's sizes.
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarIdleLabelFontSize);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Double, SidebarIdleRowHeight);

        // axan: sidebar.iconFontScale, font family -> multiplier for one-character icons
        // (src/inc/AxanGlyphScale.h). Families: the built-in table's families, then (each
        // part sorted) those in the user's map and those the startup entries', live sessions'
        // and profiles' icons are drawn from. Scale = the effective value, Default = the
        // built-in one. Set writes the map (the default value removes the key); Reset
        // removes the key.
        Windows.Foundation.Collections.IVectorView<String> SidebarIconFontFamilies { get; };
        Double SidebarIconFontScale(String family);
        Double SidebarIconFontScaleDefault(String family);
        Boolean IsSidebarIconFontScaleSet(String family);
        void SetSidebarIconFontScale(String family, Double value);
        void ResetSidebarIconFontScale(String family);
        // axan #48: sidebar.iconFontWeight, font family -> "normal" | "semibold" | "bold"
        // (src/inc/AxanGlyphWeight.h). Weight = the effective canonical name ("normal" when
        // unset or invalid). Set writes the map ("normal" removes the key). IsSidebarIconFontSet
        // = the family has a scale or a weight override; ResetSidebarIconFont removes both
        // (the row's Reset button).
        String SidebarIconFontWeight(String family);
        void SetSidebarIconFontWeight(String family, String weight);
        Boolean IsSidebarIconFontSet(String family);
        void ResetSidebarIconFont(String family);
        // axan #48: sidebar.largeIconsGrowRow, a glyph larger than the icon box grows the box
        // and the row gets taller to fit; off clips it to the box. Default false.
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, SidebarLargeIconsGrowRow);
    }
}
