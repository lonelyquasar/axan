    axan D19 — the global "Startup sessions" page: a row list over the global
    GlobalAppSettings.StartupSessions tree. Each row picks a profile (which shell) and
    edits its directory/command/name/icon; indent/outdent nest, duplicate clones, import
    loads a portable .toml. Replaces the per-profile Startup page.
-->
<Page x:Class="Microsoft.Terminal.Settings.Editor.StartupSessions"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:model="using:Microsoft.Terminal.Settings.Model"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!--
        Wider than the standard settings column: each row is a full toolbar of controls,
        and the directory/command boxes deserve the room on a wide window.
    -->
    <StackPanel MaxWidth="2200"
                Style="{StaticResource SettingsStackStyle}">

        <TextBlock Margin="0,0,0,4"
                   Style="{StaticResource TextBlockSubHeaderStyle}"
                   Text="Startup sessions" />
        <TextBlock Margin="0,0,0,12"
                   Foreground="{ThemeResource SubgroupHeaderBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="The shells axan opens at launch. Each row spawns a profile (the shell) in an optional directory, optionally running a command; indent a row to nest it under the one above. A separator row is a divider in the sidebar tree — a line or an open gap — that spawns nothing. Honored on a plain launch — command-line shells take precedence." />

        <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LaunchEntryViewModel">
                    <!--
                        A Grid, not a horizontal StackPanel: the Name / Directory / Command
                        boxes are star-sized so they grow with the page instead of clipping
                        a long path or command at a fixed width on a wide window (the page's
                        MaxWidth is raised above for the same reason), and shrink first when
                        the window is narrow so the trailing Duplicate/Delete buttons stay in
                        view instead of the row being cropped. Everything else stays Auto-sized.
                    -->
                    <Grid Margin="{x:Bind IndentMargin, Mode=OneWay}"
                          ColumnSpacing="4"
                          TabFocusNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="70" MaxWidth="400" />
                            <ColumnDefinition Width="2*" MinWidth="100" MaxWidth="900" />
                            <ColumnDefinition Width="2*" MinWidth="100" MaxWidth="900" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--
                            axan #429: the per-row buttons are icon-only and Narrator doesn't
                            read ToolTips as names, so each carries an AutomationProperties.Name.
                        -->
                        <!--
                            axan #13: launch order is list order, so rows reorder in place.
                            A move carries the row's whole subtree and swaps it with the
                            previous/next SIBLING (same nesting level); the glyphs match the
                            NewTabMenu page's reorder buttons.
                        -->
                        <Button Grid.Column="0"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Move entry up"
                                Click="MoveEntryUp_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Move up (with its children)">
                            <FontIcon FontSize="12" Glyph="&#xF0AD;" />
                        </Button>
                        <Button Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Move entry down"
                                Click="MoveEntryDown_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Move down (with its children)">
                            <FontIcon FontSize="12" Glyph="&#xF0AE;" />
                        </Button>
                        <Button Grid.Column="2"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Outdent entry"
                                Click="OutdentEntry_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Outdent (move out one level)">
                            <FontIcon FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                        <Button Grid.Column="3"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Indent entry"
                                Click="IndentEntry_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Indent (nest under the row above)">
                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                        <!--
                            ItemsSource is set in code-behind (ProfileCombo_Loaded): a classic
                            {Binding ElementName=RootPage} can't resolve property paths on a
                            C++/WinRT page (no ICustomPropertyProvider — it fails silently and
                            the combo stays empty), and x:Bind in this template only reaches the
                            row's LaunchEntryViewModel. DisplayMemberPath has the same disease
                            (it reflects on Model.Profile), hence the explicit item template.
                        -->
                        <!--
                            axan #3: a separator row swaps the session editor (profile, icon,
                            color, Name / Directory / Command — each Visibility-bound to
                            SessionVisibility) for the compact divider editor further down,
                            which spans the same columns and binds SeparatorVisibility. Both
                            live in the one template; the row's Kind picks which shows.
                        -->
                        <ComboBox Grid.Column="4"
                                  Width="150"
                                  AutomationProperties.Name="Profile"
                                  Loaded="ProfileCombo_Loaded"
                                  SelectionChanged="ProfileCombo_SelectionChanged"
                                  Tag="{x:Bind}"
                                  ToolTipService.ToolTip="Which shell to spawn (a profile)"
                                  Visibility="{x:Bind SessionVisibility, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:Profile">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!--
                            axan #438: the icon is picked, not typed. The button shows the live
                            preview; its flyout (content built in code-behind on Opening — same
                            classic-Binding limitation as the profile combo above) offers the
                            builtin-glyph vocabulary, an image-file browse, and a free-text row
                            for emoji / tokens.
                        -->
                        <Button Grid.Column="5"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Choose icon"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Icon: pick a builtin glyph, browse for an image, or type an emoji"
                                Visibility="{x:Bind SessionVisibility, Mode=OneWay}">
                            <ContentControl Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Content="{x:Bind IconPreview, Mode=OneWay}"
                                            IsTabStop="False" />
                            <Button.Flyout>
                                <Flyout Opening="IconFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                        <!--
                            axan #13: the session color — the same swatch vocabulary the
                            sidebar's node editor offers. The ellipse previews the row's
                            color (hollow = none); the flyout (content built in code-behind
                            on Opening, same classic-Binding limitation as the icon picker)
                            offers the palette swatches and the icon/text/both target.
                        -->
                        <Button Grid.Column="6"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Choose color"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Session color: recolor the sidebar icon and/or label text"
                                Visibility="{x:Bind SessionVisibility, Mode=OneWay}">
                            <Ellipse Width="14"
                                     Height="14"
                                     Fill="{x:Bind ColorPreviewBrush, Mode=OneWay}"
                                     Stroke="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                     StrokeThickness="1" />
                            <Button.Flyout>
                                <Flyout Opening="ColorFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                        <TextBox Grid.Column="7"
                                 PlaceholderText="Name"
                                 Text="{x:Bind Name, Mode=TwoWay}"
                                 ToolTipService.ToolTip="Sidebar label template (optional)"
                                 Visibility="{x:Bind SessionVisibility, Mode=OneWay}" />
                        <TextBox Grid.Column="8"
                                 PlaceholderText="Directory"
                                 Text="{x:Bind Directory, Mode=TwoWay}"
                                 ToolTipService.ToolTip="Working directory; ~ = home (optional)"
                                 Visibility="{x:Bind SessionVisibility, Mode=OneWay}" />
                        <TextBox Grid.Column="9"
                                 PlaceholderText="Command"
                                 Text="{x:Bind Command, Mode=TwoWay}"
                                 ToolTipService.ToolTip="Command to run; empty = the profile's shell"
                                 Visibility="{x:Bind SessionVisibility, Mode=OneWay}" />
                        <!--
                            axan #3: the separator editor — shown in place of the session
                            controls above when the row's Kind is "separator". Style and
                            Placement are literal-item ComboBoxes driven by SelectedIndex
                            (SeparatorStyleIndex / PlacementIndex on the row VM): the
                            ItemsSource caveat on the profile combo applies to any list the
                            page would hand a row template. Height is in session-row units;
                            the VM setter clamps to [0.1, 10] and rounds to tenths, so the
                            box snaps to the stored value on commit.
                        -->
                        <StackPanel Grid.Column="4"
                                    Grid.ColumnSpan="6"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind SeparatorVisibility, Mode=OneWay}">
                            <FontIcon VerticalAlignment="Center"
                                      FontSize="14"
                                      Glyph="&#xE738;" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="Separator" />
                            <ComboBox Width="100"
                                      AutomationProperties.Name="Separator style"
                                      SelectedIndex="{x:Bind SeparatorStyleIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Line draws a rule across the sidebar; Space leaves an open gap">
                                <ComboBoxItem Content="Line" />
                                <ComboBoxItem Content="Space" />
                            </ComboBox>
                            <muxc:NumberBox Width="120"
                                            AutomationProperties.Name="Separator height"
                                            LargeChange="1"
                                            Maximum="10"
                                            Minimum="0.1"
                                            SmallChange="0.5"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="Height in session rows: 1 = one row, 0.5 = half a row, 2 = double-space"
                                            Value="{x:Bind Height, Mode=TwoWay}" />
                            <ComboBox Width="100"
                                      AutomationProperties.Name="Separator placement"
                                      SelectedIndex="{x:Bind PlacementIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Inline keeps this position in the list; Bottom pins the separator below its siblings, so sessions added later land above it">
                                <ComboBoxItem Content="Inline" />
                                <ComboBoxItem Content="Bottom" />
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="10"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Duplicate entry"
                                Click="DuplicateEntry_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Duplicate this row">
                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                        </Button>
                        <Button Grid.Column="11"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="Delete entry"
                                Click="DeleteEntry_Click"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Remove this row">
                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="AddEntryButton"
                    Click="AddEntry_Click">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Margin="8,0,0,0" Text="Add session" />
                </StackPanel>
            </Button>
            <!--  axan #3: append a separator row (a divider in the sidebar tree; edited
                  inline in its row above).  -->
            <Button x:Name="AddSeparatorButton"
                    Click="AddSeparator_Click"
                    ToolTipService.ToolTip="Add a divider row to the tree — a line or an open gap that spawns nothing.">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="14" Glyph="&#xE738;" />
                    <TextBlock Margin="8,0,0,0" Text="Add separator" />
                </StackPanel>
            </Button>
            <Button x:Name="ImportButton"
                    Click="Import_Click"
                    ToolTipService.ToolTip="Load startup sessions from a portable axan startup-sessions .toml, replacing the list above.">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    <TextBlock Margin="8,0,0,0" Text="Import from TOML…" />
                </StackPanel>
            </Button>
            <!--  axan #14: snapshot the live session tree into this list (Linux "Capture
                  current window" parity). Clicking opens the confirm flyout — the replace
                  is destructive and captured entries carry no command.  -->
            <Button x:Name="CaptureButton"
                    AutomationProperties.Name="Save current as startup"
                    ToolTipService.ToolTip="Replace the list above with a snapshot of the sessions currently open in the window.">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <TextBlock Margin="8,0,0,0" Text="Save current as startup" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="CaptureConfirmFlyout">
                        <StackPanel MaxWidth="320" Spacing="10">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Replace the startup sessions above with the sessions currently open in the window? Existing entries will be lost. Commands won't be carried over — you'll need to re-add any." />
                            <Button HorizontalAlignment="Right"
                                    Click="CaptureConfirm_Click"
                                    Content="Replace" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!--  axan #435: a failed TOML import was previously silent end to end. Opened by
              Import_Click when ImportFromToml returns false; the detailed reason is in
              <LocalState>\logs\axan.log.  -->
        <muxc:InfoBar x:Name="ImportFailureBar"
                      Title="Import failed"
                      Margin="0,8,0,0"
                      IsClosable="True"
                      IsOpen="False"
                      Message="Couldn't load startup sessions from that file; the list above was left unchanged. See logs\axan.log in the app's LocalState folder for the reason."
                      Severity="Error" />

        <!--  axan #14: a zero-session capture (nothing live to save) never wipes the
              list — surface why nothing happened instead of failing silently.  -->
        <muxc:InfoBar x:Name="CaptureFailureBar"
                      Title="Nothing captured"
                      Margin="0,8,0,0"
                      IsClosable="True"
                      IsOpen="False"
                      Message="No live sessions to capture from the window; the list above was left unchanged."
                      Severity="Warning" />

        <TextBlock Margin="0,10,0,0"
                   Foreground="{ThemeResource SubgroupHeaderBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="A portable .toml mirror is written automatically when you save — find startup-sessions.toml (this list) and per-profile mirrors in the app's LocalState 'profiles' folder. Import startup-sessions.toml on another machine to carry these sessions across." />
    </StackPanel>
</Page>
