<Page x:Class="Microsoft.Terminal.Settings.Editor.GlobalAppearance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:model="using:Microsoft.Terminal.Settings.Model"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="EnumComboBoxTemplate"
                          x:DataType="local:EnumEntry">
                <TextBlock Text="{x:Bind EnumName, Mode=OneWay}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Style="{StaticResource SettingsStackStyle}">
        <!--  Theme  -->
        <local:SettingContainer x:Uid="Globals_Theme">
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemsSource="{x:Bind ViewModel.ThemeList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentTheme, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="model:Theme">
                        <TextBlock Text="{x:Bind local:GlobalAppearanceViewModel.ThemeNameConverter((model:Theme)), Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </local:SettingContainer>

        <!--
            axan #2: sidebar matches profile transparency. Paints the session sidebar with the
            focused profile's background brush (color + opacity) and leaves the backdrop behind
            the terminal clear, overriding the theme's sidebar/content keys.
        -->
        <local:SettingContainer x:Uid="Globals_SidebarMatchesProfileTransparency">
            <ToggleSwitch IsOn="{x:Bind ViewModel.SidebarMatchesProfileTransparency, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--
            axan #31: minutes before an idle session's sidebar row is de-emphasised (dimmed,
            smaller). 0 turns it off. Rows that need attention are never de-emphasised.
        -->
        <local:SettingContainer x:Uid="Globals_SidebarIdleAfterMinutes">
            <muxc:NumberBox LargeChange="15"
                            Maximum="1440"
                            Minimum="0"
                            SmallChange="1"
                            Style="{StaticResource NumberBoxSettingStyle}"
                            Value="{x:Bind ViewModel.SidebarIdleAfterMinutes, Mode=TwoWay}" />
        </local:SettingContainer>

        <!--
            axan: what a finished / errored session's row keeps once it has been seen. Keep
            leaves the last report on the second line (muted, with its age); Clear drops it.
        -->
        <local:SettingContainer x:Uid="Globals_SidebarStatusAfterSeen">
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                      ItemsSource="{x:Bind ViewModel.SidebarStatusAfterSeenList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentSidebarStatusAfterSeen, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}" />
        </local:SettingContainer>

        <!--  axan: sidebar.stateLabels, the small state word beside the right-edge icon  -->
        <local:SettingContainer x:Uid="Globals_SidebarStateLabels">
            <ToggleSwitch IsOn="{x:Bind ViewModel.SidebarStateLabels, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--
            axan #34: sidebar.hoistStates, the states that list a session in the sidebar's
            hoisted group (shown when sidebar.needsYouGroup is on). One checkbox per state,
            built in code-behind (GlobalAppearance::_BuildHoistStateBoxes); a Startup sessions
            entry can override the list.
        -->
        <local:SettingContainer x:Uid="Globals_SidebarHoistStates"
                                CurrentValue="{x:Bind ViewModel.SidebarHoistStatesSummary, Mode=OneWay}"
                                Style="{StaticResource ExpanderSettingContainerStyle}">
            <StackPanel Spacing="8">
                <VariableSizedWrapGrid x:Name="HoistStatesPanel"
                                       Orientation="Horizontal" />
                <HyperlinkButton x:Uid="Globals_SidebarHoistStatesReset"
                                 Click="HoistStatesReset_Click" />
            </StackPanel>
        </local:SettingContainer>

        <!--  axan: sidebar.showAgentName, an agent at rest shows its session name  -->
        <local:SettingContainer x:Uid="Globals_SidebarShowAgentName">
            <ToggleSwitch IsOn="{x:Bind ViewModel.SidebarShowAgentName, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--
            axan: sidebar.stateGlyphs. The right-edge icon a row shows for its slot state: the
            same picker as the Startup page's icon button, plus a Default cell. The text beside
            the button says Default / None / the chosen value.
        -->
        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphIdle">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarIdleGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the idle (agent at rest) icon"
                        Tag="idle"
                        ToolTipService.ToolTip="Idle: a status-reporting program is present and waiting at its prompt. Also shown once you have opened a finished or errored session. Default: a robot.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarIdleGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphWorking">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarWorkingGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the working icon"
                        Tag="working"
                        ToolTipService.ToolTip="Working: the agent is running a turn. Default: a lightning bolt.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarWorkingGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphBlocked">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarBlockedGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the blocked icon"
                        Tag="blocked"
                        ToolTipService.ToolTip="Blocked: the program is waiting for you (permission, an answer or a login). Default: none; the dot on the icon already marks it.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarBlockedGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphDone">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarDoneGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the done icon"
                        Tag="done"
                        ToolTipService.ToolTip="Done: finished and not yet looked at. Default: none; the dot on the icon already marks it.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarDoneGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphError">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarErrorGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the error icon"
                        Tag="error"
                        ToolTipService.ToolTip="Error: the program reported an error. Default: none; the red dot on the icon already marks it.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarErrorGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphRunning">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarRunningGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the running (shell command) icon"
                        Tag="running"
                        ToolTipService.ToolTip="Running: a shell command is executing (needs shell integration; only for a pane with no status-reporting program). Default: a play triangle.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarRunningGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphPermission">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarPermissionGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the blocked: needs permission icon"
                        Tag="permission"
                        ToolTipService.ToolTip="Needs permission: a tool call is waiting for your approval. Overrides Blocked for this kind. Default: same as Blocked.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarPermissionGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphQuestion">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarQuestionGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the blocked: needs answer icon"
                        Tag="question"
                        ToolTipService.ToolTip="Needs answer: the program (e.g. Claude Code) is waiting for you to pick an option. Overrides Blocked for this kind. Default: same as Blocked.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarQuestionGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <local:SettingContainer x:Uid="Globals_SidebarStateGlyphAuth">
            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.8"
                           Text="{x:Bind ViewModel.SidebarAuthGlyphLabel, Mode=OneWay}" />
                <Button MinWidth="44"
                        AutomationProperties.Name="Choose the blocked: needs login icon"
                        Tag="auth"
                        ToolTipService.ToolTip="Needs login: the program is waiting for authentication. Overrides Blocked for this kind. Default: same as Blocked.">
                    <ContentControl Width="20"
                                    Height="20"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{x:Bind ViewModel.SidebarAuthGlyphPreview, Mode=OneWay}"
                                    IsTabStop="False" />
                    <Button.Flyout>
                        <Flyout Opening="StateGlyphFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:SettingContainer>

        <!--  Position of new tab  -->
        <local:SettingContainer x:Uid="Globals_NewTabPosition">
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                      ItemsSource="{x:Bind ViewModel.NewTabPositionList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentNewTabPosition, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}" />
        </local:SettingContainer>

        <!--  Show Titlebar  -->
        <local:SettingContainer x:Uid="Globals_ShowTitlebar">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTabsInTitlebar, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}"
                          Toggled="{x:Bind ViewModel.ShowTitlebarToggled}" />
        </local:SettingContainer>

        <!--
            axan D20: the tab strip is retired (the session sidebar is the navigator), so the
            upstream "Always show tabs" / "Show tabs in full screen" settings now only govern
            whether the title bar row (the strip's old home, still hosting the caption buttons)
            is shown. Relabeled accordingly in Resources.resw rather than hidden, so the row
            height stays user-controllable. The underlying settings keys are unchanged.
        -->
        <!--  Always show the title bar row (upstream: always show tabs)  -->
        <local:SettingContainer x:Uid="Globals_AlwaysShowTabs">
            <ToggleSwitch IsEnabled="{x:Bind mtu:Converters.InvertBoolean(ViewModel.ShowTabsInTitlebar), Mode=OneWay}"
                          IsOn="{x:Bind ViewModel.AlwaysShowTabs, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Show the title bar row in full screen (upstream: show tabs in full screen)  -->
        <local:SettingContainer x:Uid="Globals_ShowTabsFullscreen">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTabsFullscreen, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Show Acrylic in Tab Row  -->
        <local:SettingContainer x:Uid="Globals_AcrylicTabRow">
            <ToggleSwitch IsOn="{x:Bind ViewModel.UseAcrylicInTabRow, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Show Title in Titlebar  -->
        <local:SettingContainer x:Uid="Globals_ShowTitleInTitlebar">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTitleInTitlebar, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Always on Top  -->
        <local:SettingContainer x:Uid="Globals_AlwaysOnTop">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Tab Width Mode  -->
        <local:SettingContainer x:Uid="Globals_TabWidthMode">
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                      ItemsSource="{x:Bind ViewModel.TabWidthModeList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentTabWidthMode, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}" />
        </local:SettingContainer>

        <!--  Disable Animations  -->
        <!--  NOTE: the UID is "DisablePaneAnimationsReversed" not "DisablePaneAnimations". See GH#9124 for more details.  -->
        <local:SettingContainer x:Uid="Globals_DisableAnimationsReversed">
            <ToggleSwitch IsOn="{x:Bind ViewModel.InvertedDisableAnimations, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Always Show Notification Icon  -->
        <local:SettingContainer x:Uid="Globals_AlwaysShowNotificationIcon">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AlwaysShowNotificationIcon, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Minimize To Notification Area  -->
        <local:SettingContainer x:Uid="Globals_MinimizeToNotificationArea">
            <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToNotificationArea, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Automatically hide window  -->
        <local:SettingContainer x:Uid="Globals_AutoHideWindow">
            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoHideWindow, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Show Admin Shield  -->
        <local:SettingContainer x:Uid="Globals_ShowAdminShield">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowAdminShield, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>

        <!--  Enable Unfocused Acrylic  -->
        <local:SettingContainer x:Uid="Globals_EnableUnfocusedAcrylic">
            <ToggleSwitch IsOn="{x:Bind ViewModel.EnableUnfocusedAcrylic, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingContainer>
    </StackPanel>
</Page>
