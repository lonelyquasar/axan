//
// axan D19 — the global "Startup sessions" page view-model. Edits the global
// GlobalAppSettings.StartupSessions tree: a flat ordered list of LaunchEntryViewModel rows,
// each referencing a WT profile (which shell) and carrying its own directory/command/icon/color
// plus parent/child nesting. Replaces the per-profile Startup editor (M14/D17).

import "ProfileViewModel.idl";

namespace Microsoft.Terminal.Settings.Editor
{
    runtimeclass StartupSessionsViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        // MainPage constructs a fresh view-model on every navigation to the page, so the
        // settings reference is fixed at construction (no UpdateSettings re-target needed).
        StartupSessionsViewModel(Microsoft.Terminal.Settings.Model.CascadiaSettings settings);

        // The startup tree rows, in launch (= list) order.
        IObservableVector<LaunchEntryViewModel> Entries { get; };
        // The profiles offered in each row's shell picker.
        IObservableVector<Microsoft.Terminal.Settings.Model.Profile> AvailableProfiles { get; };
        // The default profile's GUID, so a row with no explicit profile shows the right shell.
        String DefaultProfileGuid { get; };

        void AddEntry();
        void DeleteEntry(LaunchEntryViewModel vm);
        void DuplicateEntry(LaunchEntryViewModel vm);
        void IndentEntry(LaunchEntryViewModel vm);
        void OutdentEntry(LaunchEntryViewModel vm);
        // Replace the tree with the startup sessions parsed from a portable profile TOML.
        Boolean ImportFromToml(String path);
    }
}
