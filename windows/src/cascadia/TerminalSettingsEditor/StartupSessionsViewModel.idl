//
// axan D19 — the global "Startup sessions" page view-model. Edits the global
// GlobalAppSettings.StartupSessions tree: a flat ordered list of LaunchEntryViewModel rows,
// each referencing a WT profile (which shell) and carrying its own directory/command/icon/color
// plus parent/child nesting. Replaces the per-profile Startup editor (M14/D17).

import "ProfileViewModel.idl";

namespace Microsoft.Terminal.Settings.Editor
{
    // axan #14: TerminalApp registers this on MainPage; it snapshots the LIVE session tree
    // as launch entries. The editor edits a settings clone and can't see live sessions,
    // so "Save current as startup" pulls the snapshot from the app through this.
    delegate Windows.Foundation.Collections.IVector<Microsoft.Terminal.Settings.Model.LaunchEntry> LiveStartupEntriesProvider();

    runtimeclass StartupSessionsViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        // MainPage constructs a fresh view-model on every navigation to the page, so the
        // settings reference is fixed at construction (no UpdateSettings re-target needed).
        StartupSessionsViewModel(Microsoft.Terminal.Settings.Model.CascadiaSettings settings);

        // The startup tree rows, in launch (= list) order.
        IObservableVector<LaunchEntryViewModel> Entries { get; };
        // The profiles offered in each row's shell picker.
        IObservableVector<Microsoft.Terminal.Settings.Model.Profile> AvailableProfiles { get; };
        // The default profile's GUID, so a row with no explicit profile shows the right shell.
        String DefaultProfileGuid { get; };

        // axan #38: the row the page's detail panel edits and the toolbar acts on. The
        // list pushes the user's pick in; every structural op re-selects the row it acted
        // on (move / indent / outdent: that row; add / duplicate: the new row; delete: the
        // next sibling, else the row above; import / capture / construction: the first
        // row, or none when the list is empty). Raised again after each op even when the
        // row is unchanged, because the in-place RemoveAt/InsertAt clears a ListView's
        // selection.
        LaunchEntryViewModel SelectedEntry;
        Boolean HasSelection { get; };
        // Whether the matching op would do anything for SelectedEntry (false with no
        // selection). Re-raised on selection change and after every structural op.
        Boolean CanMoveUp { get; };
        Boolean CanMoveDown { get; };
        Boolean CanIndent { get; };
        Boolean CanOutdent { get; };

        void AddEntry();
        // axan #3: append a root separator row (line style, one row tall, inline). It is
        // an ordinary row afterwards — move/indent/outdent/duplicate/delete all apply.
        void AddSeparator();
        void DeleteEntry(LaunchEntryViewModel vm);
        void DuplicateEntry(LaunchEntryViewModel vm);
        void IndentEntry(LaunchEntryViewModel vm);
        void OutdentEntry(LaunchEntryViewModel vm);
        // axan #13: reorder a row among its SIBLINGS, carrying its whole subtree with it —
        // launch order is list order, so this is the only way to rearrange without
        // delete-and-re-add. No-op when the row is already first/last among its siblings.
        void MoveEntryUp(LaunchEntryViewModel vm);
        void MoveEntryDown(LaunchEntryViewModel vm);
        // axan #38: the page's built-in drag reorder. BeginDrag (on DragItemsStarting)
        // records the dragged row and suspends commits: the ListView moves only that row,
        // in place, and the tree is inconsistent until the drop. NormalizeAfterDrag (on
        // DragItemsCompleted, always paired with BeginDrag) moves the row's subtree after
        // it, re-derives its parent from where it landed, commits once and re-selects it.
        // A drag that left the row where it was commits nothing.
        void BeginDrag(LaunchEntryViewModel head);
        void NormalizeAfterDrag(LaunchEntryViewModel head);
        // Replace the tree with the startup sessions parsed from a portable profile TOML.
        Boolean ImportFromToml(String path);
        // axan #14: replace the tree with a snapshot of the live session tree (pulled
        // through the registered LiveStartupEntriesProvider). Returns the number of
        // sessions captured; 0 (no provider / no live sessions) leaves the list untouched.
        UInt32 CaptureLiveStartup();
    }
}
