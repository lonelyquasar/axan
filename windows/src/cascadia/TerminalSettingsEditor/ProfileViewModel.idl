#define OBSERVABLE_PROJECTED_PROFILE_SETTING(Type, Name) \
    OBSERVABLE_PROJECTED_SETTING(Type, Name);            \
    Object Name##OverrideSource { get; }

namespace Microsoft.Terminal.Settings.Editor
{
    runtimeclass NavigateToProfileArgs
    {
        ProfileViewModel Profile { get; };
        IHostedInWindow WindowRoot { get; };
    }

    runtimeclass DeleteProfileEventArgs
    {
        Guid ProfileGuid { get; };
    }

    runtimeclass BellSoundViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Path { get; };
        String DisplayPath { get; };
        String SubText { get; };
        Boolean ShowDirectory { get; };
        Boolean FileExists { get; };
    }

    // axan D19: one editable row in the global Startup sessions tree (StartupSessionsViewModel).
    // Wraps the editable fields of a GlobalSettings.StartupSessions element; Depth drives tree
    // indentation in the editor (derived by walking ParentId). Edits raise PropertyChanged so the
    // owning view-model re-commits the model vector.
    runtimeclass LaunchEntryViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String ParentId;
        // axan D19: GUID of the WT profile this row spawns (which shell). "" -> default profile.
        String Profile;
        String Name;
        String Directory;
        String Command;
        String Icon;
        // Icon in the portable vocabulary: builtin glyphs surface as "builtin:NAME" tokens
        // (editable text); emoji / image paths pass through verbatim. Backed by Icon.
        String IconPortable;
        // axan #422: per-node recolor token (palette name / "#hex" / "") + target
        // ("icon"/"text"/"both"/""), round-tripped through GlobalSettings.StartupSessions
        // (D19; formerly the per-profile Profile.DefaultLaunchEntries).
        String Color;
        String ColorTarget;
        Int32 Depth;
        Windows.UI.Xaml.Thickness IndentMargin { get; };
        Windows.UI.Xaml.Controls.IconElement IconPreview { get; };
        // axan #13: Color resolved against the app theme for the row's color-button
        // preview; null (theme foreground) when no color is set. Backed by Color.
        Windows.UI.Xaml.Media.Brush ColorPreviewBrush { get; };

        // axan #3: row kind — "" / "session" = a shell session; "separator" = a divider row
        // that spawns nothing (Profile/Name/Directory/Command/Icon/Color are ignored). It
        // nests and orders like a session. Mirrors Model.LaunchEntry.Kind.
        String Kind;
        // axan #3 (separators only): "line" (default) draws a rule; "space" is an open gap.
        String SeparatorStyle;
        // SeparatorStyle as a picker index (0 = line, 1 = space) for the page's
        // literal-item ComboBox (SelectedIndex two-way; see the ItemsSource caveat in
        // StartupSessions.xaml). Backed by SeparatorStyle.
        Int32 SeparatorStyleIndex;
        // axan #3 (separators only): height in units of one session row, tenths,
        // clamped to [0.1, 10]; the setter normalizes (0 / NaN -> 1.0).
        Double Height;
        // axan #3 (separators only): "" / "inline" (default) keeps list position;
        // "bottom" pins the separator to the bottom of its sibling scope.
        String Placement;
        // Placement as a picker index (0 = inline, 1 = bottom). Backed by Placement.
        Int32 PlacementIndex;
        // Derived from Kind; re-notified when Kind changes. The two Visibility forms let
        // the row template swap the session editor for the separator editor without a
        // converter.
        Boolean IsSeparator { get; };
        Boolean IsSession { get; };
        Windows.UI.Xaml.Visibility SessionVisibility { get; };
        Windows.UI.Xaml.Visibility SeparatorVisibility { get; };
    }

    enum ProfileSubPage
    {
        Base = 0,
        Appearance = 1,
        Terminal = 2,
        Advanced = 3
    };

    enum IconType
    {
        None = 0,
        FontIcon,
        Image,
        Emoji
    };

    runtimeclass ProfileViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
