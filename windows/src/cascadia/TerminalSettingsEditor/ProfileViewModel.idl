        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, Elevate);
        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, ReloadEnvironmentVariables);
        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, RightClickContextMenu);
