        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, AutoMarkPrompts);
        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, RepositionCursorWithMouse);
        OBSERVABLE_PROJECTED_PROFILE_SETTING(Boolean, ForceVTInput);
