<component
  xmlns="https://specifications.freedesktop.org/metainfo/1.0"
  xmlns:xi="http://www.w3.org/2001/XInclude"
  type="desktop-application">
  <id>sh.axan.Axan.desktop</id>
  <metadata_license>GPL-3.0+ or GFDL-1.3-only</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name>axan</name>
  <summary>Terminal with a tree-of-shells sidebar</summary>
  <description>
    <p>axan is a terminal emulator with a vertical sidebar tree of shells instead of a tab bar — built for keeping several shells or agents open side-by-side under one window, grouped into a tree you can see at a glance. Profiles can declare startup session trees, and sidebar labels render live template variables.</p>
    <p>axan is a fork of GNOME Terminal. Report axan bugs to axan, not to GNOME — anything broken here is the fork's doing.</p>
  </description>
  <recommends>
    <control>console</control>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>HighContrast</kudo>
    <kudo>ModernToolkit</kudo>
    <kudo>SearchProvider</kudo>
    <kudo>UserDocs</kudo>
  </kudos>
  <developer id="sh.axan"><name>Lonely Quasar</name></developer>
  <url type="homepage">https://github.com/lonelyquasar/axan</url>
  <url type="bugtracker">https://github.com/lonelyquasar/axan/issues</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">sh.axan.Axan.desktop</launchable>
</component>
